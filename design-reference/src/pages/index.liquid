---
pagination:
  data: site.languages
  size: 1
  alias: language
permalink: "{{ language.prefix }}/"
layout: layouts/base.liquid
titleKey: meta.homeTitle
---
{%- comment -%} Temporary intro — the Salon replaces it (Salon ticket). {%- endcomment -%}
<section class="s-intro">
  <div class="s-intro__inner u-container">
    <p class="u-eyebrow">{{ 'intro.eyebrow' | t }}</p>
    <h1 class="s-intro__word c-wordmark" data-motion="word">{{ site.brand }}</h1>
    <p class="s-intro__tagline u-display" data-motion="lines">{{ 'intro.tagline' | t }}</p>
    <a class="c-button" href="{{ '/shop/women/' | lurl }}">{{ 'intro.cta' | t }} <span class="c-arrow" aria-hidden="true">⟶</span></a>
  </div>
</section>

{%- comment -%}
  Temporary motion study — exercises M3, M5, M6, M7 and M8 until the real home sections
  (Made by Hand, Shop by Category …) take these effects over in their own tickets.
{%- endcomment -%}
<section class="s-motion-demo">
  <div class="s-motion-demo__inner u-container">
    <p class="u-eyebrow">{{ 'motionDemo.eyebrow' | t }}</p>
    <h2 class="s-motion-demo__title u-h2" data-motion="chars">{{ 'motionDemo.title' | t }}</h2>
    <p class="s-motion-demo__text" data-motion="lines">{{ 'motionDemo.text' | t }}</p>
    <div class="s-motion-demo__frame u-parallax" data-motion="reveal parallax">
      <div class="s-motion-demo__picture" aria-hidden="true"></div>
    </div>
    <ul class="s-motion-demo__cards" data-motion="cards">
      {%- assign demoCategories = 'outerwear,knitwear,trousers,accessories' | split: ',' %}
      {%- for c in demoCategories %}
      <li class="s-motion-demo__card">
        <div class="s-motion-demo__tile" aria-hidden="true"></div>
        <p class="s-motion-demo__name u-h3">{{ 'category.' | append: c | t }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
