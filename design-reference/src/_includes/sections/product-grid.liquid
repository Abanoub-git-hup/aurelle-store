{%- comment -%}
  A curated product row with Women / Men tabs — New In, The Edit, Most Loved.
  {% include 'sections/product-grid', id: 'new-in', list: shop.lists.newIn, eyebrowKey: 'newIn.eyebrow', titleKey: 'newIn.title' %}
  Without JS both departments show one after the other; with JS they become tabs.
{%- endcomment -%}
{%- assign firstDept = shop.departments | first -%}
<section class="s-product-grid" aria-labelledby="{{ id }}-title" data-component="dept-tabs">
  <div class="u-container">
    <div class="s-product-grid__head">
      <div>
        <p class="u-eyebrow">{{ eyebrowKey | t }}</p>
        <h2 class="u-h2" id="{{ id }}-title" data-motion="chars">{{ titleKey | t }}</h2>
      </div>
      <a class="c-text-link" href="{{ '/shop/' | append: firstDept | append: '/' | lurl }}" data-view-all>
        {{ 'common.viewAll' | t }} <span class="c-arrow" aria-hidden="true">⟶</span>
      </a>
    </div>

    <div class="c-dept-tabs" role="tablist" aria-label="{{ 'a11y.department' | t }}" data-tablist hidden>
      {%- for dept in shop.departments %}
      <button class="c-dept-tabs__tab" type="button" role="tab" id="{{ id }}-tab-{{ dept }}"
        aria-controls="{{ id }}-panel-{{ dept }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        {%- unless forloop.first %} tabindex="-1"{% endunless %}
        data-href="{{ '/shop/' | append: dept | append: '/' | lurl }}">{{ 'nav.' | append: dept | t }}</button>
      {%- endfor %}
    </div>

    {%- for dept in shop.departments %}
    {%- assign group = id | append: '-' | append: dept %}
    <div class="s-product-grid__panel" role="tabpanel" id="{{ id }}-panel-{{ dept }}" aria-labelledby="{{ id }}-tab-{{ dept }}" data-panel>
      <div class="s-product-grid__grid" data-motion="cards">
        {%- for p in list[dept] %}
        {% include 'components/product-card', product: p, group: group %}
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>
